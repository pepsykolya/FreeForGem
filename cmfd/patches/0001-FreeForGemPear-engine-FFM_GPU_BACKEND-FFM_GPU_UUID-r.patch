From 3fa057ff89748abfe031eb9f7872b699596fad42 Mon Sep 17 00:00:00 2001
From: cmfdamd <pepsykolya@gmail.com>
Date: Wed, 21 Oct 2026 07:37:21 +0300
Subject: [PATCH] FreeForGemPear engine: FFM_GPU_BACKEND + FFM_GPU_UUID run the
 pool client on a non-NVIDIA GPU (OpenCL worker) without nvidia-smi; auto
 batch 32 there

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/cmfd-miner/src/main.rs      |  4 ++++
 crates/cmfd-miner/src/telemetry.rs | 26 ++++++++++++++++++++++++++
 2 files changed, 30 insertions(+)

diff --git a/crates/cmfd-miner/src/main.rs b/crates/cmfd-miner/src/main.rs
index 670c81c..89664fa 100644
--- a/crates/cmfd-miner/src/main.rs
+++ b/crates/cmfd-miner/src/main.rs
@@ -949,7 +949,11 @@ struct ProductionV4PoolMinerOptions {
 }
 
 /// Automatic batch size: 64 forwards on 11 GB+ cards (measured ~+1 % on RTX 4070 Ti), 32 otherwise.
+/// FreeForGemPear: 32 on a non-NVIDIA GPU (FFM_GPU_BACKEND, see telemetry.rs) — same speed there, half the share latency.
 fn ffm_auto_batch(gpu_uuid: &str) -> u32 {
+    if telemetry::non_nvidia_backend().is_some() {
+        return 32;
+    }
     let total_mib = std::process::Command::new("nvidia-smi")
         .args(["--query-gpu=memory.total", "--format=csv,noheader,nounits", "-i", gpu_uuid])
         .output()
diff --git a/crates/cmfd-miner/src/telemetry.rs b/crates/cmfd-miner/src/telemetry.rs
index 51429c4..deb414b 100644
--- a/crates/cmfd-miner/src/telemetry.rs
+++ b/crates/cmfd-miner/src/telemetry.rs
@@ -17,7 +17,33 @@ pub(crate) struct GpuTelemetry {
     pub(crate) memory_total_mib: Option<f64>,
 }
 
+/// FreeForGemPear: `FFM_GPU_BACKEND=<name>` (anything but `cuda`) runs the engine on a non-NVIDIA GPU (the OpenCL worker
+/// `cmfd-v4-replay-ocl`): nvidia-smi is not used, the one selected GPU is `FFM_GPU_UUID` (nvidia-smi format
+/// `GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx`, physical index 0), sensors are N/A (the launcher reports power itself).
+pub(crate) fn non_nvidia_backend() -> Option<String> {
+    std::env::var("FFM_GPU_BACKEND")
+        .ok()
+        .map(|v| v.trim().to_ascii_lowercase())
+        .filter(|v| !v.is_empty() && v != "cuda")
+}
+
+fn non_nvidia_devices() -> Option<Result<BTreeMap<i32, GpuTelemetry>, String>> {
+    let backend = non_nvidia_backend()?;
+    let uuid = std::env::var("FFM_GPU_UUID").unwrap_or_default();
+    if !valid_gpu_uuid(&uuid) {
+        return Some(Err(format!(
+            "FFM_GPU_BACKEND={backend} needs FFM_GPU_UUID in the form GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
+        )));
+    }
+    let mut map = BTreeMap::new();
+    map.insert(0, GpuTelemetry { uuid, ..GpuTelemetry::default() });
+    Some(Ok(map))
+}
+
 pub(crate) fn query_nvidia_smi() -> Result<BTreeMap<i32, GpuTelemetry>, String> {
+    if let Some(devices) = non_nvidia_devices() {
+        return devices;
+    }
     let output = Command::new(nvidia_smi_command())
         .args([
             format!("--query-gpu={NVIDIA_SMI_QUERY}"),
-- 
