# FreeForGemPear — see LICENSE
# Portable release build of the host (glibc 2.31, runs on Ubuntu 20.04+ / HiveOS); links the prebuilt prebuilt/linux-x86_64/libpearlgpu.so:
#   docker build -f Dockerfile.build -t ffgp-build . && docker run --rm -v "$PWD":/src ffgp-build
# (the CUDA devel base image is only used for its libcuda stub: the prebuilt library depends on libcuda.so.1; nvcc is not run)
FROM nvidia/cuda:12.6.3-devel-ubuntu20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git build-essential pkg-config \
 && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.98.1
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /src
CMD ["./build.sh"]
